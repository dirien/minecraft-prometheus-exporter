# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
.idea
cmd/exporter
**/dist
**/password
**/cosign-*
**/cosign-*.sig
**/*-cosign.pub
minecraft-exporter

# Ignore the .claude/ workspace, but keep the test-minecraft-exporter skill
# (the rest is per-developer state: settings, transcripts, worktrees).
.claude/*
!.claude/skills
.claude/skills/*
!.claude/skills/test-minecraft-exporter

# Per-developer MCP server config
.mcp.json
